# =============================================================
# ZERO AI NEET Prep — Environment Variables
# Copy this to .env and fill in your values
# =============================================================

# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/neetprep
DATABASE_SSL=false

# ---- Server ----
PORT=5001
NODE_ENV=development
SESSION_SECRET=your-random-64-char-session-secret-here
PARENT_LINK_SECRET=your-random-secret-for-parent-portal-links-here

# ---- AI Services ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3.5
OLLAMA_CODEMOD_MODEL=qwen2.5-coder:1.5b

# ---- Razorpay (Payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZERO AI NEET" <noreply@neet.zeroai.org.in>

# ---- WhatsApp (MSG91/Gupshup) ----
WHATSAPP_API_KEY=
WHATSAPP_SENDER_ID=

# ---- Marketing Swarm ----
MARKETING_SWARM_URL=http://localhost:8001
ENABLE_CRON=0
NEET_WEBSITE_URL=https://neet.zeroai.org.in

# ---- Redis (for caching & rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Object Storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neet-assets
R2_PUBLIC_URL=

# ---- Analytics ----
GA4_MEASUREMENT_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ---- Feature Flags ----
FEATURE_AI_DOUBT_SOLVER=true
FEATURE_BATTLE_MODE=true
FEATURE_ADAPTIVE_PRACTICE=true
FEATURE_RANK_PREDICTOR=true
FEATURE_OFFLINE_MODE=true
FEATURE_PARENT_DASHBOARD=false
FEATURE_VOICE_TUTOR=false

# ---- Anti-Cheat ----
MAX_FOCUS_VIOLATIONS=5

# ---- CORS ----
CORS_ORIGIN=https://neet.zeroai.org.in
CLIENT_BASE_URL=https://neet.zeroai.org.in

# ---- Logging ----
LOG_LEVEL=info

# ---- Owner Account ----
OWNER_EMAIL=your-owner-email@example.com
OWNER_PASSWORD=your-strong-owner-password-here
